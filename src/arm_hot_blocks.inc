            0xe59cf000u, // 0x000bdedc: ldr pc, [ip]
        };
        for (unsigned j = 0; j < 8; ++j) {
            if (memory[0x000bdec0 / 4 + j] != expected[j]) return false;
        }
        return true;
    }
    default: return false;
    }
}

